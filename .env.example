# Supabase PostgreSQL connection
# Get these from: Supabase Dashboard > Settings > Database
#
# DATABASE_URL = Pooler connection (for app runtime / Vercel)
#   Go to Settings > Database > Connection string > URI tab > select "Transaction pooler"
#
# DIRECT_URL = Direct connection (for Prisma migrations, local dev)
#   Go to Settings > Database > Connection string > URI tab > select "Direct connection"

DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=15
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres